{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>cucumber/renovate-config",
    "github>cucumber/renovate-config:messages-range-strategy-widen"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned commits of cucumber C++ dependencies in workflow env vars (annotated with a renovate comment).",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+)\\s+\\w+_REF:\\s*(?<currentDigest>[0-9a-f]{7,40})"
      ]
    }
  ]
}
